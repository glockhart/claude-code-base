#!/usr/bin/env bash
# PreToolUse hook. Root-owned, mode 0555, so the agent cannot edit it.
#
# This exists because deny rules in managed settings are bypassed by
# --dangerously-skip-permissions, which is the mode the sandbox is built to make
# safe. Hooks fire from the tool execution path independently of the permission
# engine, so a non-zero exit blocks the call in BOTH modes. Exit 2 blocks and
# feeds stderr back to the model as the reason.
#
# Two classes of path, because they need different treatment:
#   SECRET      - never read and never written, by any tool.
#   WRITE_ONLY  - readable, never written. These are the deferred-execution and
#                 self-widening vectors: code that runs later on the host, or
#                 config that relaxes the sandbox in a LATER session. Reading
#                 them is legitimate and common, so only edits are refused.
set -euo pipefail

payload=$(cat)
tool=$(jq -r '.tool_name // ""' <<<"$payload" 2>/dev/null || echo "")

case "$tool" in
  Bash) subject=$(jq -r '.tool_input.command // ""' <<<"$payload" 2>/dev/null || echo "") ;;
  *)    subject=$(jq -r '.tool_input.file_path // ""' <<<"$payload" 2>/dev/null || echo "") ;;
esac
[ -n "$subject" ] || exit 0

deny() {
  echo "sandbox-secret-guard: blocked, $1 is protected by the sandbox: $2" >&2
  exit 2
}

SECRET='(/\.ssh/|/\.aws/|/\.config/gh/|/\.gnupg/|/run/secrets/|\.credentials\.json|id_ed25519|id_rsa|(^|[/ ])\.env($|[. ])|/proc/[0-9]+/environ|\.git-credentials|\.netrc)'

# A planted git hook runs on the HOST at your next commit. A planted .mcp.json
# or settings file relaxes the sandbox the next time you start a session.
B='(^|[/[:space:]])'
WRITE_ONLY="(${B}\.git/hooks/|\.mcp\.json|${B}\.claude/settings(\.local)?\.json|${B}\.github/workflows/|${B}\.devcontainer/)"

printf '%s' "$subject" | grep -qE "$SECRET" && deny "this path" "$subject"

# A shell command's intent cannot be read reliably: "cd .github/workflows" may
# precede a write, but "cat .github/workflows/ci.yml" is an everyday read.
# Refusing every mention would make ordinary work painful, so only the paths
# that are both dangerous and rarely read from a shell are blocked on mention.
# The remainder rely on the Edit-tool block above. Noted in docs/threat-model.md.
BASH_CRITICAL="(${B}\\.git/hooks|\\.mcp\\.json|${B}\\.claude/settings(\\.local)?\\.json)"

case "$tool" in
  Edit|Write|NotebookEdit|MultiEdit)
    printf '%s' "$subject" | grep -qE "$WRITE_ONLY" && deny "writing to this path" "$subject" ;;
  Bash)
    printf '%s' "$subject" | grep -qE "$BASH_CRITICAL" && deny "touching this path from a shell" "$subject" ;;
esac

exit 0
