#!/usr/bin/env bash
# PreToolUse hook. Root-owned, mode 0555, so the agent cannot edit it.
#
# This exists because deny rules in managed settings are bypassed by
# --dangerously-skip-permissions, which is the mode the sandbox is built to make
# safe. Hooks fire from the tool execution path independently of the permission
# engine, so a non-zero exit blocks the call in BOTH modes. Exit 2 blocks and
# feeds stderr back to the model as the reason.
set -euo pipefail

payload=$(cat)
tool=$(jq -r '.tool_name // ""' <<<"$payload" 2>/dev/null || echo "")

case "$tool" in
  Bash) subject=$(jq -r '.tool_input.command // ""' <<<"$payload" 2>/dev/null || echo "") ;;
  *)    subject=$(jq -r '.tool_input.file_path // ""' <<<"$payload" 2>/dev/null || echo "") ;;
esac

[ -n "$subject" ] || exit 0

deny() {
  echo "sandbox-secret-guard: blocked, this path is protected by the sandbox: $1" >&2
  exit 2
}

# Deferred escape: a planted git hook runs on the HOST the next time you commit.
case "$subject" in
  *"/.git/hooks/"*|*".git/hooks/"*) deny "$subject" ;;
esac

# Credentials and secret material, in either a path or a shell command.
if printf '%s' "$subject" | grep -qE '(/\.ssh/|/\.aws/|/\.config/gh/|/\.gnupg/|/run/secrets/|\.credentials\.json|id_ed25519|id_rsa|(^|[/ ])\.env($|[. ])|/proc/[0-9]+/environ|\.git-credentials|\.netrc)'; then
  deny "$subject"
fi

exit 0
