#!/usr/bin/env bash
# Fail-closed self-test, run by the entrypoint before the agent starts.
#
# The realistic misconfiguration this catches: someone adds a service to a
# project compose file and Docker quietly attaches the agent to the default
# bridge as well as the internal network. That is silent, full egress, and
# otherwise invisible until it is used.
set -uo pipefail

fail() { printf '\033[31m[preflight] FATAL:\033[0m %s\n' "$*" >&2; exit 70; }
ok()   { [ "${SANDBOX_VERBOSE:-0}" = 1 ] && printf '\033[2m[preflight] ok:\033[0m %s\n' "$*" >&2; return 0; }

[ "$(id -u)" -ne 0 ] || fail "running as root; the agent must never be uid 0"
ok "non-root ($(id -u))"

[ ! -S /var/run/docker.sock ] || fail "/var/run/docker.sock is mounted; that is host root"
ok "no docker socket"

# --offline runs have no network at all, so skip the network assertions.
if [ "${SANDBOX_EXPECT_PROXY:-1}" = 1 ]; then
  if timeout 2 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; then
    fail "direct egress reachable; this container is NOT on an internal-only network"
  fi
  ok "no direct route out"

  proxy_host=${SANDBOX_PROXY_HOST:-10.99.0.2}
  proxy_port=${SANDBOX_PROXY_PORT:-3128}
  timeout 3 bash -c "exec 3<>/dev/tcp/${proxy_host}/${proxy_port}" 2>/dev/null \
    || fail "egress proxy ${proxy_host}:${proxy_port} unreachable; run: claude-sandbox proxy up"
  ok "proxy reachable"
fi

exit 0
