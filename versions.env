# Pinned versions for building images in this checkout.
#
# bin/claude-sandbox does NOT require this file. It carries the same values as
# built-in defaults so it works standalone on a machine with no checkout. If
# you change a value here, change the matching default in the script too, or
# set it in ~/.config/claude-sandbox/config on each machine.

# The agent. Bump with `make bump-claude` (newest release), or pass
# CHANNEL=stable or VERSION=x.y.z. It updates the launcher default too.
CLAUDE_CODE_VERSION=2.1.278

# Base image. Node 22 is required: Claude Code needs >= 22.15 to read the OS
# certificate store, which matters the day a TLS-inspecting proxy goes in front.
NODE_IMAGE=node:22-bookworm-slim

# Image naming. REGISTRY is a namespace prefix with NO trailing slash: the
# launcher concatenates it as $REGISTRY/$image. Keep it in step with the
# built-in default in bin/claude-sandbox; make smoke fails if they drift.
BASE_IMAGE_NAME=claude-code-base
REGISTRY=ghcr.io/glockhart

# Shared infrastructure names.
PROXY_IMAGE_NAME=claude-sandbox-proxy
PROXY_IMAGE_TAG=1
NET_ISOLATED=claude-egress_isolated
NET_EXTERNAL=claude-egress_external
PROXY_IP=10.99.0.2
PROXY_PORT=3128
AUTH_VOLUME=claude-sandbox-auth
