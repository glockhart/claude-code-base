# Single source of truth for pinned versions.
# Consumed by the Makefile, docker-bake.hcl and bin/claude-sandbox.

# The agent. Bump with `make bump-claude VERSION=x.y.z`.
CLAUDE_CODE_VERSION=2.1.278

# Base image. Node 22 is required: Claude Code needs >= 22.15 to read the OS
# certificate store, which matters the day a TLS-inspecting proxy goes in front.
NODE_IMAGE=node:22-bookworm-slim

# Image naming. REGISTRY empty means local-only, never pushed.
BASE_IMAGE_NAME=claude-code-base
REGISTRY=

# Shared infrastructure names. The compose project name fixes the network names.
COMPOSE_PROJECT=claude-egress
NET_ISOLATED=claude-egress_isolated
PROXY_IP=10.99.0.2
PROXY_PORT=3128
AUTH_VOLUME=claude-sandbox-auth
